# Copy to .env and adjust. Never commit .env.
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL / MariaDB (XAMPP defaults shown)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lnu_scholarship_db

# REQUIRED in production: a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=change-me-to-a-long-random-string

SESSION_IDLE_MINUTES=30
SESSION_REMEMBER_DAYS=7
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
BCRYPT_ROUNDS=12
RATE_LIMIT_ENABLED=true
